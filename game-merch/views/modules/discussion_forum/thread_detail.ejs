<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thread Detail</title>
    <link rel="stylesheet" href="/assets/css/main.css">
    <link rel="stylesheet" href="/assets/css/forum.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css">
</head>

<body data-single-thread>

    <%- include('../../partials/navbar.ejs') %>

    <div class="page_layout ">
        <main class="main_content">

            <a href="/forum" class="back_link"><i class="ri-arrow-left-line"></i> Back to Forum</a>

            <div id="thread_detail_container">
                <p class="status-msg">Loading thread...</p>
            </div>

            <section class="replies_section" id="replies_section"></section>

            <section class="reply_form_section">
                <h3 class="reply_from_heading">Leave a Reply</h3>
                <form class="reply_form" id="reply_form">
                     <div class="form_group">
                        <label for="reply_author_input">Your name</label>
                        <input type="text" id="reply_author_input" name="reply_author" placeholder="e.g. Minh Tran" required>
                     </div>
                     <div class="form_group">
                        <label for="reply_content_input">Your reply</label>
                        <textarea id="reply_content_input" name="reply_content" rows="4" placeholder="Write your reply here..." required></textarea>
                     </div>
                     <button type="submit" class="submit_btn">Post Reply</button>
                </form>
            </section>
        </main>

        <aside class="sidebar">
            <div class="sidebar_box">
                <div class="sidebar_box_header">
                    <h3>Related Products</h3>
                    <a href="/shop">View Shop</a>
                </div>

                <div id="forum_related_products"></div>
                
                <a href="/shop" class="sidebar_cta">View All Products</a>
            </div>
        </aside>    
    </div>

    <!--  Delete modal HTML -->
    <div class="confirm_modal_overlay" id="delete_modal">
        <div class="confirm_modal_box">
            <p>Are you sure you want to delete this thread?</p>
            <div class="confirm_modal_actions">
                <button id="cancel_delete_btn">Cancel</button>
                <button class="confirm_delete_btn" id="confirm_delete_btn">Delete</button>
            </div>
        </div>
    </div>

    <script src="/assets/js/script.js"></script>
    <script src="/assets/js/forumscript.js"></script>
    <script src="/assets/js/auth-validation.js"></script>

    <%- include('../../partials/footer') %>

</body>
</html>