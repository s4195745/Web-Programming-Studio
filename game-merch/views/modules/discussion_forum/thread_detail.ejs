<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thread Detail</title>
    <link rel="stylesheet" href="/assets/css/main.css">
    <link rel="stylesheet" href="/assets/css/forum.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css">
</head>

<body>

    <script>
        document.addEventListener('DOMContentLoaded', function(){
            document.querySelectorAll('.js-related-product').forEach(function(el) {
                 el.addEventListener('click', function() {
                    const product = JSON.parse(el.getAttribute('data-product'));
                    sessionStorage.setItem('selectedProduct', JSON.stringify(product));
                });
             });
        });
        
    </script>

    <%- include('../../partials/navbar.ejs') %>

    <div class="page_layout ">
        <main class="main_content">

            <a href="/forum" class="back_link"><i class="ri-arrow-left-line"></i> Back to Forum</a>

            <article class="thread_card thread_detail_post <%= thread.pinned ? 'pinned' : '' %>">
                <% if (thread.pinned) { %>
                <span class="pinned_badged"><i class="ri-pushpin-fill"></i>Pinned</span>
                <% } %>

                <div class="card_header">
                    <img src="../../../assets/Product Images/avatar.jpg" alt="<%= thread.author %> avatar" class="avatar">
                    <span class="author_name"><%= thread.author %></span>
                    <time class="post_time" datetime="<%= thread.timestamp %>"><%= thread.timestamp %></time>

                    <% if (!thread.pinned) { %>
                    <div class="options_menu">
                        <input type="checkbox" id="menu_post_<%= thread.id %>" class="options_toggle_checkbox" hidden>
                        <label for="menu_post_<%= thread.id %>" class="options_trigger">
                            <i class="ri-more-2-fill"></i>
                        </label>
                        <div class="options_dropdown">
                            <a href="/forum/<%= thread.id %>/edit" class="options_item"><i class="ri-edit-line"></i>Edit</a>
                            <a href="#" class="options_item delete_item" data-id="<%= thread.id %>"><i class="ri-delete-bin-line"></i>Delete</a>
                        </div>
                    </div>
                    <% } %>
                </div>

                <h1 class="thread_title"><%= thread.title %></h1>

                <div class="thread_content">
                    <% if (thread.content) { %><p><%= thread.content %></p><% } %>
                    <% if (thread.images && thread.images.length === 1 ) { %>
                    <img src="<%= thread.images[0] %>" alt="Image attached to thread: <%= thread.title %> " class="content_img">
                    <% } else if (thread.images && thread.images.length > 1 ) { %>
                    <div class="content_gallery">
                        <% thread.images.forEach(function(img) { %>
                        <img src="<%= img %>" alt="Image attached to thread: <%= thread.title %>" class="content_img">
                        <% }); %>
                    </div>
                    <% } %>
                </div>

                <div class="card_footer">
                    <input type="checkbox" id="like_thread_<%= thread.id %>" class="reaction_toggle_checkbox">
                    <label for="like_thread_<%= thread.id %>" class="reaction_btn">
                        <i class="ri-heart-line icon_outline"></i>
                        <i class="ri-heart-fill icon_filled"></i>
                    </label>
                </div>
            </article>

            <section class="replies_section">
                <h2 class="replies_heading">
                    <%= thread.replies ? thread.replies.length : 0 %> Repl<%= (thread.replies && thread.replies.length === 1 ) ? 'y' : 'ies' %>
                </h2>

                <% if (!thread.replies || thread.replies.length === 0) { %>
                <div class="empty_state">
                    <i class="ri-chat-3-line"></i>
                    <p>No replies yet. Be the first to reply! </p>
                </div>
                <% } %>

                <% if (thread.replies) { %>
                    <% thread.replies.forEach(function(r, i) { %>
                    <div class="reply_item">
                        <div class="reply_header">
                            <img src="../../../assets/Product Images/avatar.jpg" alt="<%= r.author %> avatar" class="avatar">
                            <span class="author_name"><%= r.author %></span>
                            <time class="post_time" datetime="<%= r.timestamp %>"><%= r.timestamp %></time>
                        </div>
                        <div class="reply_content">
                            <p><%= r.content %></p>
                        </div>
                        <div class="reply_footer">
                            <input type="checkbox" id="like_reply_<%= thread.id %>_<%= i %>" class="reaction_toggle_checkbox" hidden>
                            <label for="like_reply_<%= thread.id %>_<%= i %>" class="reaction_btn">
                                <i class="ri-heart-line icon_outline"></i>
                                <i class="ri-heart-fill icon_filled"></i>
                            </label>
                        </div>     
                    </div>
                    <% }); %>
                    <% } %>
            </section>

            <section class="reply_form_section">
                <h3 class="reply_form_heading">Leave a reply</h3>
                <form class="reply_form" action="/forum/<%= thread.id %>/reply" method="post">
                    <div class="form_group">
                        <label for="reply_author_input">Your name</label>
                        <input type="text" id="reply_author_input" name="reply_author" placeholder="e.g. Minh Tran" required>
                    </div>
                    <div class="form_group">
                        <label for="reply_content_input">Your reply</label>
                        <textarea id="reply_content_input" name="reply_content" rows="4" placeholder="Write your reply..." required></textarea>
                    </div>
                    <button type="submit" class="submit_btn">Post Reply</button>
                </form>
            </section>
        </main>

        <aside class="sidebar">
            <div class="sidebar_box">
                <div class="sidebar_box_header">
                    <h3>Related Products</h3>
                    <a href="/shop">View Shop</a>
                </div>

                <% products.forEach(function(p) { %>
                <a href="/product_detail" class="product_item js-related-product" data-product="<%= JSON.stringify(p) %>">
                    <div class="product_thumb">
                        <img src="<%= p.colors ? p.colors[0].mainImage.replace('../../assets', '/assets') : '' %>" alt="<%= p.title %>">
                    </div>
                    <div class="product_info">
                        <div class="product_name"><%= p.title %></div>
                        <div class="product_price">$<%= p.price.toFixed(2) %></div>
                    </div>
                </a>
                <% }); %>
                
                <a href="/shop" class="sidebar_cta">View All Products</a>
            </div>
        </aside>    

    </div>
    <script src="/assets/js/script.js"></script>


    <%- include('../../partials/footer') %>

</body>
</html>