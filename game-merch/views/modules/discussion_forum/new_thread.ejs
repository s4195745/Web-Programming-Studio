<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Thread</title>
    <link rel="stylesheet" href="/assets/css/main.css">
    <link rel="stylesheet" href="/assets/css/forum.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css">
</head>

<body>
    <%- include('../../partials/navbar.ejs') %>

    <div class="page_layout single_column">
        <main class="main_content">
            <a href="/forum" class="back_link"><i class="ri-arrow-left-line"></i> Back to Forum</a>
            
            <div class="new_thread_box">
                <h1 class="new_thread_heading">Ask a new question</h1>
                <p class="new_thread_subheading">Share your question with the Lootbox community — other collectors and
                    buyers can help.</p>

                <form class="new_thread_form" id="new_thread_forum" enctype="multipart/form-data">

                    <!-- Author -->
                    <div class="form_group">
                        <label for="author_name_input">Your name</label>
                        <input type="text" id="author_name_input" name="author_name" placeholder="e.g. Minh Tran"
                            required>
                    </div>

                    <!-- Title -->
                    <div class="form_group">
                        <label for="thread_title_input">Thread title</label>
                        <input type="text" id="thread_title_input" name="thread_title"
                            placeholder="Summarize your question in one line" required>
                    </div>

                    <!-- Content -->
                    <div class="form_group">
                        <label for="thread_content_input">Content</label>
                        <textarea id="thread_content_input" name="thread_content" rows="6"
                            placeholder="Describe your question in detail..." required></textarea>
                    </div>

                    <!-- Image upload -->
                    <div class="form_group">
                        <label for="thread_image_input">Attach image (optional)</label>
                        <input type="file" id="thread_image_input" name="thread_image" accept="image/*" multiple>
                        <span class="form_hint">You can attach more than one image.</span>
                    </div>

                    <!-- Timestamp note: not a user input, auto-generated on submit -->
                    <p class="form_hint">Post date and time will be recorded automatically when you submit.</p>

                    <div class="form_actions">
                        <a href="/forum" class="cancel_btn">Cancel</a>
                        <button type="submit" class="submit_btn">Post Question</button>
                    </div>

                </form>
            </div>
        </main>
    </div>
    
    <script src="/assets/js/script.js"></script>
    <script src="/assets/js/forumscript.js"></script>
    <script src="/assets/js/auth-validation.js"></script>

    <%- include('../../partials/footer.ejs') %>
</body>
</html>