<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sitemap - LootBox</title>
    <link rel="stylesheet" href="/assets/css/main.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css">
</head>

<body>

    <%- include('../../partials/navbar.ejs') %>
    
    <!-- Added top padding to prevent the fixed navbar from overlapping the title -->
    <div class="sitemap_layout" style="padding-top: 120px;">
        <h1 class="sitemap_heading">Sitemap</h1>
        <p class="sitemap_subheading" style="display: block; color: #666; margin-bottom: 20px;">
            A full list of every key page in Lootbox, organized by section.
        </p>

        <div class="sitemap_grid">

            <!-- Shop -->
            <div class="sitemap_section">
                <h3><i class="ri-store-2-line"></i> Shop</h3>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/shop">Shopping</a></li>
                    <li><a href="/cart">Cart</a></li>
                    <li><a href="/checkout">Checkout</a></li>
                </ul>
            </div>

            <!-- Discussion Forum -->
            <div class="sitemap_section">
                <h3><i class="ri-discuss-line"></i> Discussion Forum</h3>
                <ul>
                    <li><a href="/forum">Forum Hub</a></li>
                    <li><a href="/forum/new">Ask a Question</a></li>

                </ul>
            </div>

            <!-- Blog -->
            <div class="sitemap_section">
                <h3><i class="ri-article-line"></i> Blog</h3>
                <ul>
                   <li><a href="/blog">Blog Feed</a></li>
                   <li><a href="/UserBlog">Manage Your Blog</a></li>
                </ul>
            </div>

            <!-- Review & Wishlist (Combined to save space) -->
            <div class="sitemap_section">
                <h3><i class="ri-star-line"></i> Review</h3>
                <ul>
                    <li><a href="/review">Reviews</a></li>
                </ul>
                
                <h3 style="margin-top: 25px;"><i class="ri-bookmark-fill"></i> Wishlist</h3>
                <ul>
                    <li><a href="/wishlist">Wishlist</a></li>
                </ul>
            </div>

            <!-- Account -->
            <div class="sitemap_section">
                <h3><i class="ri-user-line"></i> Account</h3>
                <ul>
                    <!-- Fixed URLs to match viewRoutes.js -->
                    <li><a href="/login">Login</a></li>
                    <li><a href="/register">Register</a></li>
                    <li><a href="/profile">My Profile</a></li>
                    <li><a href="/edit_profile">Edit Profile</a></li>
                    <li><a href="/change_password">Change Password</a></li>
                    <li><a href="/verify_password">Verify Password</a></li>
                    <li><a href="/forgot_password">Forgot Password</a></li>
                    <li><a href="/delete_account">Delete Account</a></li>
                </ul>
            </div>

            <!-- Other -->
            <div class="sitemap_section">
                <h3><i class="ri-links-line"></i> Others</h3>
                <ul>
                    <li><a href="/sitemap">Sitemap</a></li>
                    <li><a href="/admin">Admin Control Panel</a></li>
                </ul>
            </div>
            
        </div>
    </div>

    <script src="/assets/js/auth-validation.js"></script>
    <script src="/assets/js/cartscript.js"></script>

    <%- include('../../partials/footer.ejs') %>

</body>
</html>