<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Set New Password - LootBox</title>
    <link rel="stylesheet" href="/assets/css/main.css">
    <link rel="stylesheet" href="/assets/css/auth.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css" rel="stylesheet"/>
</head>
<body class="dashboard-bg">

 <%- include('../../partials/navbar') %>

    <div class="dashboard-wrapper">
        <aside class="dashboard-sidebar">
            <ul>
                <li><a href="/profile">Profile</a></li>
                <li><a href="/edit_profile" class="active">Edit Profile</a></li>
                <li><a href="/cart">Orders</a></li>
                <li><a href="/wishlist">Wish List</a></li>
                <li><a href="#">Help / FAQ</a></li>
            </ul>
        </aside>

        <main class="dashboard-content">
            <form id="change-password-form">
                <div class="dashboard-card">
                    <div class="card-header-flex">
                        <div class="card-title">Set New Password</div>
                    </div>
                    
                    <div class="form-row">
                        <label class="form-label">New Password</label>
                        <div class="form-input-wrapper">
                            <input type="password" id="new-password" required>
                            <span class="error-msg" id="new-password-error"></span>
                        </div>
                    </div>

                    <div class="form-row no-border-bottom">
                        <label class="form-label">Confirm New Password</label>
                        <div class="form-input-wrapper">
                            <input type="password" id="confirm-new-password" required>
                            <span class="error-msg" id="confirm-new-error"></span>
                        </div>
                    </div>

                    <div class="action-buttons">
                        <button type="submit" class="btn-orange">Update Password</button>
                        <a href="/edit_profile" class="btn-cancel">Cancel</a>
                    </div>
                </div>
            </form>
        </main>
    </div>

    <script src="/assets/auth-validation.js"></script>
    <script src="/assets/js/script.js"></script>

  <%- include('../../partials/footer') %>
</body>
</html>