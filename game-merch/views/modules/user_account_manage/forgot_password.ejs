<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password</title>
    
    <link rel="stylesheet" href="/assets/css/main.css">
    <link rel="stylesheet" href="/assets/css/auth.css">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css" rel="stylesheet"/>
</head>
<body>

 <%- include('../../partials/navbar') %>

    <div class="auth-container">
        <div class="auth-header">
            <p>Reset your password</p>
            <h2>Forgot Password</h2>
        </div>

        <!-- Form submits to the confirmation page simulation -->
        <form class="auth-form" action="/forgot_password_confirm" method="GET">
            <div class="input-group">
                <p class="instruction-text">
                    Enter your email address and we'll send you a code to reset your password.
                </p>
                <input type="email" id="reset-email" name="email" placeholder="Email address" required>
            </div>
            
            <button type="submit" class="auth-btn">Send Code</button>
            
            <p class="auth-link mt-25">
                Remembered your password? <a href="/login">Sign In</a>
            </p>
        </form>
    </div>
    
    <script src="/assets/js/auth-validation.js"></script>
    <script src="/assets/js/script.js"></script>
    

  <%- include('../../partials/footer') %>
    
</body>
</html>