<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Password - LootBox</title>
    <link rel="stylesheet" href="/assets/css/main.css">
    <link rel="stylesheet" href="/assets/css/auth.css">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css" rel="stylesheet"/>
</head>
<body class="dashboard-bg">

 <%- include('../../partials/navbar') %>

    <div class="dashboard-wrapper">
        <aside class="dashboard-sidebar">
            <ul>
                <li><a href="/profile">Profile</a></li>
                <li><a href="/edit_profile" class="active">Edit Profile</a></li>
                <li><a href="#">Orders</a></li>
                <li><a href="#">Wish List</a></li>
                <li><a href="#">Help / FAQ</a></li>
            </ul>
        </aside>

        <main class="dashboard-content">
            <!-- Form submits to the next step: changing the password -->
            <form id="verify-password-form">
                <div class="dashboard-card">
                    <div class="card-header-flex">
                        <div class="card-title">Verify Current Password</div>
                    </div>
                    
                    <p class="instruction-text">
                        For your security, please enter your current password to continue.
                    </p>

                    <div class="form-row no-border-bottom">
                        <label class="form-label">Current Password</label>
                        <div class="form-input-wrapper">
                            <input type="password" required>
                        </div>
                    </div>

                    <div class="action-buttons">
                        <button type="submit" class="btn-orange">Continue</button>
                        <a href="/edit_profile" class="btn-cancel">Cancel</a>
                    </div>
                </div>
            </form>
        </main>
    </div>
        
    <script src="/assets/js/auth-validation.js"></script>
    <script src="/assets/js/cartscript.js"></script>
    

  <%- include('../../partials/footer') %>
</body>
</html>