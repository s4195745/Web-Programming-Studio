<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin - User Management</title>
</head>
<body>
  <h1>User Management</h1>
  <table id="users-table" border="1">
    <thead>
      <tr>
        <th>ID</th>
        <th>Username</th>
        <th>Role</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody></tbody>
  </table>

  <script>
    async function loadUsers() {
      const res = await fetch('/api/admin/users');
      if (!res.ok) {
        alert("Failed to load user list");
        return;
      }
      const users = await res.json();
      const tbody = document.querySelector('#users-table tbody');
      tbody.innerHTML = '';

      users.forEach(user => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>${user.id}</td>
          <td>${user.username}</td>
          <td>${user.role}</td>
          <td>${user.isLocked ? 'Locked' : 'Active'}</td>
          <td>
            ${user.isLocked 
              ? `<button onclick="toggleLock('${user.id}', 'unlock')">Unlock</button>` 
              : `<button onclick="toggleLock('${user.id}', 'lock')">Lock</button>`}
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    async function toggleLock(userId, action) {
      const res = await fetch(`/api/admin/users/${userId}/${action}`, { method: 'POST' });
      if (res.ok) {
        loadUsers();
      } else {
        alert(`Failed to ${action} user.`);
      }
    }

    document.addEventListener('DOMContentLoaded', loadUsers);
  </script>
</body>
</html>