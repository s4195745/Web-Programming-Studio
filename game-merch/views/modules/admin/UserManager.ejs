<%- include('../../partials/navbar') %>

<link rel="stylesheet" type="text/css" href="/assets/css/admin.css" />

<!-- Middle-Right Floating Admin Panel -->
<div id="admin-side-panel" class="admin-drawer">
  <div class="admin-drawer-header">
    <h3>User Management</h3>
    <button class="admin-close-btn" onclick="toggleAdminPanel()">&times;</button>
  </div>
  
  <div class="admin-drawer-body">
    <table id="admin-users-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>User</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<!-- Lock/Unlock Confirmation Modal -->
<div id="admin-confirm-modal" class="admin-modal-overlay">
  <div class="admin-modal-box">
    <h4 id="admin-modal-title">Confirm Action</h4>
    <p id="admin-modal-message">Are you sure you want to perform this action?</p>
    <div class="admin-modal-actions">
      <button class="admin-btn-cancel" onclick="closeAdminModal()">Cancel</button>
      <button id="admin-modal-confirm-btn" class="admin-btn-confirm">Confirm</button>
    </div>
  </div>
</div>
<script src="/assets/js/adminscript.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        loadAdminUsers();
    });
</script>