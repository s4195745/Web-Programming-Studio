<main class="dashboard-content">
    <div class="dashboard-card">
        <div class="card-header-flex">
            <div class="card-title">User Manager</div>
        </div>

        <table class="user-management-table" style="width: 100%; text-align: left; margin-top: 15px;">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <!-- test -->
                <tr data-user-id="2">
                    <td>Admin</td>
                    <td>admin@lootbox.com</td>
                    <td>admin</td>
                    <td><span class="status-badge">Active</span></td>
                    <td>
                        <button type="button" class="btn-danger" onclick="toggleUserLock('101', true)">
                            Lock Account
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</main>

<script>
async function toggleUserLock(userId, shouldLock) {
    const actionText = shouldLock ? "lock" : "unlock";
    const confirmMessage = `Are you sure you want to ${actionText} this user?`;

    if (!confirm(confirmMessage)) return;

    try {
        const response = await fetch(`/api/admin/users/${userId}/lock-status`, {
            method: 'PUT',
            headers: { 
                'Content-Type': 'application/json' 
            },
            body: JSON.stringify({ isLocked: shouldLock })
        });

        const result = await response.json();

        if (response.ok) {
            alert(result.message || `User account successfully ${shouldLock ? 'locked' : 'unlocked'}.`);
            location.reload(); // Refresh view to update row state
        } else {
            alert(result.message || "Failed to update user lock status.");
        }
    } catch (err) {
        console.error("Error toggling user lock status:", err);
        alert("An error occurred while communicating with the server.");
    }
}

// Middleware to block locked users from performing operations
function checkAccountStatus(req, res, next) {
    if (req.user && req.user.isLocked) {
        // Clear session or destroy cookie if needed
        req.logout?.(); 
        return res.status(403).json({ 
            error: "Your account is locked. You cannot perform any operations." 
        });
    }
    next();
}

module.exports = checkAccountStatus;
</script>