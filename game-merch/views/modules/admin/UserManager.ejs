<main class="dashboard-content">
    <div class="dashboard-card">
        <div class="card-header-flex">
            <div class="card-title">User Manager</div>
        </div>

        <table class="user-management-table" style="width: 100%; text-align: left; margin-top: 15px;">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% if (users && users.length > 0) { %>
                    <% users.forEach(user => { %>
                        <tr data-user-id="<%= user._id || user.id %>">
                            <td><%= user.username %></td>
                            <td><%= user.email %></td>
                            <td><%= user.role %></td>
                            <td>
                                <span class="status-badge <%= user.isLocked ? 'status-locked' : 'status-active' %>">
                                    <%= user.isLocked ? 'Locked' : 'Active' %>
                                </span>
                            </td>
                            <td>
                                <% if (user.isLocked) { %>
                                    <button type="button" class="btn-success" onclick="toggleUserLock('<%= user._id || user.id %>', false)">
                                        Unlock Account
                                    </button>
                                <% } else { %>
                                    <button type="button" class="btn-danger" onclick="toggleUserLock('<%= user._id || user.id %>', true)">
                                        Lock Account
                                    </button>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="5" style="text-align: center;">No accounts found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</main>

<script>
async function toggleUserLock(userId, shouldLock) {
    const actionText = shouldLock ? "lock" : "unlock";
    if (!confirm(`Are you sure you want to ${actionText} this user?`)) return;

    try {
        const response = await fetch(`/api/admin/users/${userId}/lock-status`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ isLocked: shouldLock })
        });

        const result = await response.json();

        if (response.ok) {
            alert(result.message || `User account successfully ${shouldLock ? 'locked' : 'unlocked'}.`);
            location.reload();
        } else {
            alert(result.message || "Failed to update user lock status.");
        }
    } catch (err) {
        console.error("Error toggling user lock status:", err);
        alert("An error occurred while communicating with the server.");
    }
}
</script>