<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Game Merch Store - Home</title>
    <link rel="stylesheet" type="text/css" href="/assets/css/blog.css" />
    <link rel="stylesheet" type="text/css" href="/assets/css/main.css" />
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css" rel="stylesheet"/>
    <script>
  window.currentUser = "<%= (typeof user !== 'undefined' && user) ? (user.username || user.name) : '' %>";
</script>
</head>

 <%- include('../../partials/navbar') %>

  <main class="main-container">
    <div class="article-page">
      <section class="manage-section">
        <h2 id="form-title">Create a New Post</h2>
        <form class="post-form" onsubmit="event.preventDefault();">
          <input type="hidden" id="post-id" value="" />

          <div class="form-group">
            <label for="post-title">Post Title</label>
            <input type="text" id="post-title" class="form-input" placeholder="Enter post title" required />
          </div>

          <div class="form-group">
            <label for="post-category">Category</label>
            <select id="post-category" class="form-input">
              <option value="Merch">📱 Merch</option>
              <option value="Fan-art">🎨 Fan-art</option>
              <option value="Discussion">💬 Discussion</option>
              <option value="Review">⭐ Review</option>
            </select>
          </div>

          <div class="form-group">
            <label for="post-image">Image URL (Optional)</label>
            <input type="url" id="post-image" class="form-input" placeholder="https://example.com/image.jpg" />
          </div>

          <div class="form-group">
            <label for="post-secondary-image">Secondary Image URL (Optional)</label>
            <input type="url" id="post-secondary-image" class="form-input" placeholder="https://example.com/secondary-image.jpg" />
          </div>

          <div class="form-group">
            <label for="post-summary">Overview (Optional)</label>
            <input type="text" id="post-summary" class="form-input" placeholder="Short description of your post." />
          </div>

          <div class="form-group">
            <label for="post-content">Content</label>
            <textarea id="post-content" class="form-input" rows="4" placeholder="Write your post content..." required></textarea>
          </div>

          <div class="form-actions">
            <button type="submit" class="submit-btn">Publish Post</button>
            <button type="button" class="cancel-btn" style="display: none;">Cancel Edit</button>
          </div>
        </form>
      </section>

      <hr class="section-divider" />

      <section class="manage-section">
        <h2>Your Posts</h2>
        <div class="user-posts-list">
          <div class="menu-dropdown">
            <button type="button" class="three-dots-btn" aria-label="Post Options">⋮</button>
            <div class="dropdown-menu">
              <button type="button" class="dropdown-item edit-item">Edit</button>
              <button type="button" class="dropdown-item delete-item">Delete</button>
            </div>
          </div>
        </div>
      </section>

      <div class="bottom-nav">
        <a href="/blog" class="back-link">← Back to Posts</a>
      </div>
    </div>
  </main>

  <%- include('../../partials/footer') %>
<script src="/assets/js/blogscript.js"></script>
<script src="/assets/js/script.js"></script>
</body>
</html>